{"protocolSection":{"identificationModule":{"nctId":"NCT00433511","orgStudyIdInfo":{"id":"NCI-2009-00561"},"secondaryIdInfos":[{"id":"NCI-2009-00561","type":"REGISTRY","domain":"CTRP (Clinical Trial Reporting Program)"},{"id":"CDR0000528955"},{"id":"E5103"},{"id":"ECOG-E5103"},{"id":"07-963"},{"id":"E5103","type":"OTHER","domain":"ECOG-ACRIN Cancer Research Group"},{"id":"E5103","type":"OTHER","domain":"CTEP"},{"id":"U10CA180820","type":"NIH","link":"https://reporter.nih.gov/quickSearch/U10CA180820"},{"id":"U10CA021115","type":"NIH","link":"https://reporter.nih.gov/quickSearch/U10CA021115"}],"organization":{"fullName":"National Cancer Institute (NCI)","class":"NIH"},"briefTitle":"Doxorubicin Hydrochloride, Cyclophosphamide, and Paclitaxel With or Without Bevacizumab in Treating Patients With Lymph Node-Positive or High-Risk, Lymph Node-Negative Breast Cancer","officialTitle":"A Double-Blind Phase III Trial of Doxorubicin and Cyclophosphamide Followed by Paclitaxel With Bevacizumab or Placebo in Patients With Lymph Node Positive and High Risk Lymph Node Negative Breast Cancer"},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":4994,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Arm I (chemotherapy, placebo)","type":"ACTIVE_COMPARATOR","description":"Patients receive doxorubicin hydrochloride IV, cyclophosphamide IV over 20-30 minutes, and placebo IV over 30-90 minutes on day 1. Treatment repeats every 2 or 3 weeks for 4 courses. Beginning 3 weeks later, patients then receive paclitaxel IV over 1 hour on days 1, 8, and 15 and placebo IV over 30-90 minutes on day 1. Treatment with paclitaxel and placebo repeats every 3 weeks for 4 courses.","interventionNames":["Drug: Cyclophosphamide","Drug: Doxorubicin Hydrochloride","Other: Laboratory Biomarker Analysis","Drug: Paclitaxel","Other: Placebo Administration","Other: Quality-of-Life Assessment"]},{"label":"Arm II (chemotherapy, bevacizumab)","type":"EXPERIMENTAL","description":"Patients receive doxorubicin hydrochloride and cyclophosphamide as in arm I and bevacizumab IV over 30-90 minutes on day 1. Treatment repeats every 2 or 3 weeks for 4 courses. Beginning 3 weeks later, patients then receive paclitaxel as in arm I and bevacizumab IV over 30-90 minutes on day 1. Treatment with paclitaxel and bevacizumab repeats every 3 weeks for 4 courses.","interventionNames":["Biological: Bevacizumab","Drug: Cyclophosphamide","Drug: Doxorubicin Hydrochloride","Other: Laboratory Biomarker Analysis","Drug: Paclitaxel","Other: Quality-of-Life Assessment"]},{"label":"Arm III (chemotherapy, bevacizumab monotherapy)","type":"EXPERIMENTAL","description":"Patients receive doxorubicin hydrochloride and cyclophosphamide as in arm I and bevacizumab as in arm II. Treatment repeats every 2 or 3 weeks for 4 courses. Beginning 3 weeks later, patients then receive paclitaxel as in arm I and bevacizumab as in arm II. Treatment with paclitaxel and bevacizumab repeats every 3 weeks for 4 courses. Beginning 2 months later, patients then receive bevacizumab IV over 30-90 minutes on day 1. Treatment with bevacizumab alone repeats every 3 weeks for 10 courses.","interventionNames":["Biological: Bevacizumab","Drug: Cyclophosphamide","Drug: Doxorubicin Hydrochloride","Other: Laboratory Biomarker Analysis","Drug: Paclitaxel","Other: Quality-of-Life Assessment"]}],"interventions":[{"type":"BIOLOGICAL","name":"Bevacizumab","description":"Given IV","armGroupLabels":["Arm II (chemotherapy, bevacizumab)","Arm III (chemotherapy, bevacizumab monotherapy)"],"otherNames":["ABP 215","ABP-215","ABP215","Alymsys","Anti-VEGF","Anti-VEGF Humanized Monoclonal Antibody","Anti-VEGF Monoclonal Antibody SIBP04","Anti-VEGF rhuMAb","Avastin","Avzivi","Aybintio","BAT 1706","BAT-1706","BAT1706","BAT1706 Biosimilar","Bevacizumab awwb","Bevacizumab B